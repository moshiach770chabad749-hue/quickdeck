{
  "name": "quickdeck",
  "productName": "QuickDeck",
  "version": "1.1.1",
  "description": "Stream-deck style launcher for Windows: live GIF keys, themes, English and Hebrew",
  "author": "QuickDeck",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.quickdeck.app",
    "productName": "QuickDeck",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/icon.png",
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuickDeck",
      "runAfterFinish": true,
      "installerLanguages": [
        "en_US",
        "he_IL"
      ],
      "language": "1033",
      "artifactName": "QuickDeck-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "qdtheme",
        "name": "QuickDeck Theme",
        "description": "QuickDeck theme",
        "role": "Viewer"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.0"
  }
}
